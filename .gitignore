# Ignore OS generated files
.DS_Store
.DS_Store?
._*

# Ignore environment variables / secrets
.env
.env*.local
backend/.env
frontend/.env

# Ignore node modules & build outputs
node_modules/
**/node_modules/
dist/
**/dist/

# Ignore python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Explicitly ignore requested documents
backend/PRD.md
frontend/ARCHITECTURE.md
