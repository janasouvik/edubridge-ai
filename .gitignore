# ==========================================
# Frontend Exclusions
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ==========================================
# Backend Exclusions
# ==========================================
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/*.pyc
backend/.env
backend/.env.*
# Do not ignore .env.example
!backend/.env.example

# ==========================================
# General Exclusions
# ==========================================
__pycache__/
*.pyc
.DS_Store
.idea/
.vscode/
*.log
dist/
build/
coverage/

# ==========================================
# Explicit Document Exclusions
# ==========================================
backend/PRD.md
frontend/ARCHITECTURE.md
